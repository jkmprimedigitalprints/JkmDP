rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products, Catalog, and Materials Library
    match /products/{productId} {
      allow read, write: if true;
    }
    match /materials_library/{materialId} {
      allow read, write: if true;
    }
    match /costing_formulas/{formulaId} {
      allow read, write: if true;
    }

    // Orders
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Inventory levels and Raw Stocks
    match /inventory/{itemId} {
      allow read, write: if true;
    }

    // Expenses, capital contributions, and logging
    match /capital_materials/{materialId} {
      allow read, write: if true;
    }
    match /expenses/{expenseId} {
      allow read, write: if true;
    }
    match /user_logs/{logId} {
      allow read, write: if true;
    }

    // Customer upload files and live support chat
    match /customer_uploads/{uploadId} {
      allow read, write: if true;
    }
    match /support_chats/{chatId} {
      allow read, write: if true;
    }
    match /notifications/{notifId} {
      allow read, write: if true;
    }
    match /landing_page_reels/{reelId} {
      allow read, write: if true;
    }
  }
}
